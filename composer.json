{
    "name": "kode/scheduling",
    "version": "2.0.4",
    "description": "通用 Cron 调度器：支持任意 callable / task 的简洁健壮 PHP 定时任务库",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cron",
        "scheduler",
        "schedule",
        "task",
        "timer",
        "定时任务"
    ],
    "authors": [
        {
            "name": "Kode"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "suggest": {
        "ext-pcntl": "PCNTL 扩展 - 用于进程信号优雅退出/并发"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "support": {
        "issues": "https://github.com/kodephp/scheduling/issues",
        "source": "https://github.com/kodephp/scheduling"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Scheduling\\": "src/"
        }
    },
    "bin": [
        "bin/scheduler"
    ],
    "autoload-dev": {
        "psr-4": {
            "Kode\\Scheduling\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
